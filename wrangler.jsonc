{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moeda-arena",
  "main": "./src/infrastructure/cloudflare/proxy.mjs",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://moeda-arena.onrender.com"
  }
}
