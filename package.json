{
  "name": "moeda-arena",
  "version": "2.0.0",
  "description": "Moeda Arena - Sistema com Mercado Pago, MVC, autenticação JWT e banco de dados",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore public/ server.js",
    "minify:js": "terser src/frontend/main.js -o public/main.min.js -c -m && terser src/frontend/admin.js -o public/admin.min.js -c -m",
    "minify:css": "csso public/style.css --output public/style.min.css",
    "minify": "npm run minify:js && npm run minify:css",
    "build": "npm install && npm run minify && npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "express-validator": "^7.0.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.0.7",
    "mysql2": "^3.6.5",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "strip-comments": "^2.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "javascript-obfuscator": "^5.6.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.6",
    "terser": "^5.26.0"
  }
}
