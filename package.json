{
  "name": "moeda-arena",
  "version": "2.0.0",
  "description": "Moeda Arena - Sistema com Mercado Pago, MVC, autenticação JWT e banco de dados",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "nodemon --ignore public/ server.js",
    "minify:js": "esbuild ./src/frontend/main.js ./src/frontend/admin.js --bundle --minify --tree-shaking=true --target=es2020 --outdir=public --entry-names=[name].min",
    "minify:css": "csso public/style.css --output public/style.min.css",
    "minify": "npm run minify:js && npm run minify:css",
    "build": "npm run minify"
  },
  "dependencies": {
    "@sentry/node": "^11.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.4",
    "express-validator": "^7.0.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.6.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "strip-comments": "^2.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.6.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.6",
    "terser": "^5.26.0",
    "wrangler": "^4.142.0"
  }
}
