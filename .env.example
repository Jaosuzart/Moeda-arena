# Copie para .env. Nunca sobrescreva sua ENCRYPTION_KEY existente:
# ela é necessária para ler os dados já criptografados.
PORT=3001
NODE_ENV=development
# Número de proxies confiáveis: defina segundo a topologia da sua hospedagem.
TRUST_PROXY=0
# Origem pública do site, sem barra final. Produção deve usar HTTPS.
CORS_ORIGIN=http://localhost:3001
MP_ACCESS_TOKEN=SEU_TOKEN_MERCADO_PAGO
MP_WEBHOOK_SECRET=SUA_ASSINATURA_DE_WEBHOOK
DB_HOST=localhost
DB_PORT=3306
DB_USER=SEU_USUARIO
DB_PASSWORD=SUA_SENHA
DB_NAME=moeda_arena
DB_CONN_LIMIT=10
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_FILE=
# Gere JWT_SECRET e API_GAME_SECRET com randomBytes(32).toString('hex').
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA
API_GAME_SECRET=GERE_OUTRA_CHAVE_ALEATORIA
ENCRYPTION_KEY=GERE_UMA_CHAVE_ALEATORIA_E_GUARDE_BACKUP
# Deixe integrações opcionais vazias se não forem utilizadas.
CLIENT_ID_GOOGLE=
ADMIN_EMAIL=
TELEGRAM_URL=
WHATSAPP_URL=
WHATSAPP_ENABLED=false
SMTP_HOST=smtp.umbler.com
SMTP_PORT=587
SMTP_USER=suporte@SEU_DOMINIO
SMTP_PASS=SUA_SENHA_SMTP
SMTP_TLS_REJECT_UNAUTHORIZED=true
MIXPANEL_TOKEN=
SENTRY_DSN=
# BACKEND_ORIGIN pertence ao Worker Cloudflare. Configure em wrangler.jsonc
# ou no painel do Worker. Deve ser a origem HTTPS do Node/Express separado.
