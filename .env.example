# ======================================================
# LOJA DE TOKENS - Variáveis de Ambiente
# ======================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no repositório.

PORT=3001
NODE_ENV=development

# Mercado Pago
# Gere seu token em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=SEU_TOKEN_DO_MERCADO_PAGO_AQUI

# Banco de Dados (MariaDB / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=loja_tokens
DB_CONN_LIMIT=10

# Segurança
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=sua_chave_secreta_jwt_aqui
API_GAME_SECRET=senha_secreta_para_jogos_aqui
CLIENT_ID_GOOGLE=seu_client_id_google_aqui

# Criptografia de dados sensiveis (CPF, telefone, chave PIX, cartao)
# ATENCAO: Faca backup desta chave. Sem ela os dados criptografados nao podem ser recuperados.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=gere_uma_chave_de_64_hex_chars_aqui

# Links de Suporte
TELEGRAM_URL=https://t.me/seu_telegram_aqui
WHATSAPP_URL=https://wa.me/seu_numero_aqui